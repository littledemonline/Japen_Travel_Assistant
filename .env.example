# 앱 접속 비밀번호 (접근 제한용)
APP_PASSWORD=your_password_here

# OpenAI API Key (필수)
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 모델명 (예: gpt-6-astra, gpt-5.6-terra, gpt-4o)
OPENAI_MODEL=gpt-6-astra

# 일본 현지 맛집 검색 (Hot Pepper Gourmet API)
HOTPEPPER_API_KEY=your_hotpepper_api_key_here

# (선택) 향후 실시간 항공권/숙소 API 연동 시 사용
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
RAPIDAPI_KEY=
